== add text skips a locked lane
-- command: Add text | AddText(3333334, text: Text, duration: null, track: null)
-- before
tr_main video main
  it_v [0,300) md_video src[0,10000000)
tr_t1 text
  it_a [0,60) text "Title"
tr_t2 text locked
  it_b [30,90) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
-- after
tr_t1 text
  it_a [0,60) text "Title"
  it_#1 [100,190) text "Text"
unchanged: tr_main, tr_t2, tr_sub
-- affected: it_#1
-- changed lanes: tr_t1
-- selection: {it_#1} primary it_#1

== add text with policy reject and no room
-- command: Add text | AddText(1333334, text: Text, duration: null, track: null)
-- before
tr_main video main
  it_v [0,300) md_video src[0,10000000)
tr_t1 text
  it_a [0,60) text "Title"
tr_t2 text
  it_b [30,90) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
-- rejected: NoRoom()

== add text on an explicit busy lane moves to the nearest free one
-- command: Add text | AddText(1333334, text: Text, duration: null, track: tr_t1)
-- before
tr_main video main
  it_v [0,300) md_video src[0,10000000)
tr_t1 text
  it_a [0,60) text "Title"
tr_t2 text
  it_b [30,90) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
-- after
tr_#1 text
  it_#1 [40,130) text "Text"
unchanged: tr_main, tr_t1, tr_t2, tr_sub
-- affected: it_#1
-- changed lanes: tr_#1
-- created lanes: tr_#1
-- notices: placedOnOtherLane {it_#1}
-- selection: {it_#1} primary it_#1
-- preview creates: text@3

