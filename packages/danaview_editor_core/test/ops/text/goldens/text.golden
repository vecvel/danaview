== add text goes to a new text lane when the only lane is busy
-- command: Add text | AddText(1000000, text: Text, duration: null, track: null)
-- before: standard()
-- after
tr_#1 text
  it_#1 [30,120) text "Text"
unchanged: tr_main, tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1
-- changed lanes: tr_#1
-- created lanes: tr_#1
-- selection: {it_#1} primary it_#1
-- preview creates: text@3

== add text uses the free text lane
-- command: Add text | AddText(2000000, text: Hello, duration: null, track: null)
-- before: standard()
-- after
tr_txt text
  it_t1 [0,45) text "Title"
  it_#1 [60,150) text "Hello"
unchanged: tr_main, tr_ov1, tr_sub, tr_orig, tr_music
-- affected: it_#1
-- changed lanes: tr_txt
-- selection: {it_#1} primary it_#1

== add text prefers the topmost free lane
-- command: Add text | AddText(333334, text: Text, duration: null, track: null)
-- before
tr_main video main
  it_v [0,300) md_video src[0,10000000)
tr_t1 text
tr_t2 text
-- after
tr_t2 text
  it_#1 [10,100) text "Text"
unchanged: tr_main, tr_t1
-- affected: it_#1
-- changed lanes: tr_t2
-- selection: {it_#1} primary it_#1

== add text falls back to the lower free lane
-- command: Add text | AddText(2000000, text: Text, duration: 1000000, track: null)
-- before
tr_main video main
  it_v [0,300) md_video src[0,10000000)
tr_t1 text
  it_a [0,60) text "Title"
tr_t2 text
  it_b [30,90) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
-- after
tr_t1 text
  it_a [0,60) text "Title"
  it_#1 [60,90) text "Text"
unchanged: tr_main, tr_t2, tr_sub
-- affected: it_#1
-- changed lanes: tr_t1
-- selection: {it_#1} primary it_#1

