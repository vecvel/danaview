== speed leaves a link partner that does not share the time map alone
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(2.0), maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_a [0,30) md_video src[0,1000000) link=ln_a
  it_b [30,60) md_video src[0,1000000)
tr_other video
  it_o [0,60) md_video2 src[0,2000000) link=ln_a
-- after
tr_main video main
  it_a [0,15) md_video src[0,1000000) x2.0 link=ln_a
  it_b [15,45) md_video src[0,1000000)
unchanged: tr_other
-- affected: it_a, it_b
-- changed lanes: tr_main

== speed ripple blocked: a moved clip's partner would hit an item of its lane
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(0.5), maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_a [0,30) md_video src[0,1000000)
  it_b [30,60) md_video src[0,1000000) link=ln_b
tr_orig audio role=original
  it_b_au [30,60) md_video src[0,1000000) audio link=ln_b
  it_x [65,95) md_music src[0,1000000) audio
-- rejected: RippleBlockedByLinkedItem(it_b_au)
