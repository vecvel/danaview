== speed unchanged is a no-op
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(1.0), maintainPitch: null, ripple: null)
-- before: standard()
-- noop

== speed on a locked lane
-- command: Change speed | SetSpeed(it_c, ConstantSpeed(2.0), maintainPitch: null, ripple: null)
-- before
tr_main video main locked
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_ov1 overlay
  it_p1 [30,60) md_image src[0,1000000)
tr_txt text
  it_t1 [0,45) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
tr_music audio role=music
  it_m [0,300) md_music src[0,10000000) audio
-- rejected: TrackLocked(tr_main)

== speed blocked: the partner lane is locked
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(2.0), maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
tr_orig audio locked role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
-- rejected: TrackLocked(tr_orig)

