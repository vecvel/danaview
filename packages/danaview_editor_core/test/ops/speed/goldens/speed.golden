== speed 2x ripples the lane, the linked audio follows the same spec
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(2.0), maintainPitch: null, ripple: null)
-- before: standard()
-- after
tr_main video main
  it_a [0,30) md_video src[0,2000000) x2.0 detached link=ln_a
  it_b [30,90) md_video src[10000000,12000000)
  it_c [120,180) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,30) md_video src[0,2000000) x2.0 audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig

== speed 0.5x on a linked clip grows both and ripples the lanes
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(0.5), maintainPitch: null, ripple: null)
-- before: standard()
-- after
tr_main video main
  it_a [0,120) md_video src[0,2000000) x0.5 detached link=ln_a
  it_b [120,180) md_video src[10000000,12000000)
  it_c [210,270) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,120) md_video src[0,2000000) x0.5 audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig

== speed set from the audio partner changes the video too
-- command: Change speed | SetSpeed(it_a_au, ConstantSpeed(1.5), maintainPitch: null, ripple: null)
-- before: standard()
-- after
tr_main video main
  it_a [0,40) md_video src[0,2000001) x1.5 detached link=ln_a
  it_b [40,100) md_video src[10000000,12000000)
  it_c [130,190) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,40) md_video src[0,2000001) x1.5 audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig

== speed 0.5x without ripple clamps at the next clip
-- command: Change speed | SetSpeed(it_a, ConstantSpeed(0.5), maintainPitch: null, ripple: null)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,1000000) x0.5 detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,1000000) x0.5 audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_a, it_a_au
-- changed lanes: tr_main, tr_orig
-- notices: trimmedToFit {it_a, it_a_au}
-- clamped to: [0,60)

