== speed ramp montage
-- command: Change speed | SetSpeed(it_v, Instance of 'SpeedRamp', maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_v [0,150) md_video src[0,5000000)
  it_n [150,180) md_video src[0,1000000)
-- after
tr_main video main
  it_v [0,145) md_video src[0,5005840) ramp(0.000:1.0 0.200:0.3 0.400:3.0 0.600:0.3 0.800:3.0 1.000:1.0)
  it_n [145,175) md_video src[0,1000000)
-- affected: it_n, it_v
-- changed lanes: tr_main

== speed ramp flashIn
-- command: Change speed | SetSpeed(it_v, Instance of 'SpeedRamp', maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_v [0,150) md_video src[0,5000000)
  it_n [150,180) md_video src[0,1000000)
-- after
tr_main video main
  it_v [0,129) md_video src[0,5003417) ramp(0.000:8.0 0.200:1.0 1.000:1.0)
  it_n [129,159) md_video src[0,1000000)
-- affected: it_n, it_v
-- changed lanes: tr_main

== speed keys scale with the clip
-- command: Change speed | SetSpeed(it_v, ConstantSpeed(2.0), maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_v [0,100) md_video src[0,3333334) keys{transform.scale@0f=1.0,30f=2.0,60f=3.0,90f=4.0}
  it_n [100,130) md_video src[0,1000000)
-- after
tr_main video main
  it_v [0,50) md_video src[0,3333334) x2.0 keys{transform.scale@0f=1.0,15f=2.0,30f=3.0,45f=4.0}
  it_n [50,80) md_video src[0,1000000)
-- affected: it_n, it_v
-- changed lanes: tr_main

== speed near the end of the media loses a frame instead of overrunning it
-- command: Change speed | SetSpeed(it_s, ConstantSpeed(0.75), maintainPitch: null, ripple: null)
-- before
tr_main video main
  it_s [0,30) md_short src[0,1000000)
-- after
tr_main video main
  it_s [0,39) md_short src[0,975000) x0.75
-- affected: it_s
-- changed lanes: tr_main

