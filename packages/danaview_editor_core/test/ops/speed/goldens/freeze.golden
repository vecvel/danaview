== freeze inside a linked clip: split, still inserted with ripple, partner follows
-- command: Freeze frame | FreezeFrame(it_a, 1000000, 1000000, md_still)
-- before: standard()
-- after
tr_main video main
  it_a [0,30) md_video src[0,1000000) detached link=ln_a
  it_#1 [30,60) md_still src[0,1000000)
  it_#2 [60,90) md_video src[1000000,2000000) detached link=ln_#1
  it_b [90,150) md_video src[10000000,12000000)
  it_c [180,240) md_video2 src[0,2000000)
  ~ tx_ab it_#2|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,30) md_video src[0,1000000) audio link=ln_a
  it_#3 [60,90) md_video src[1000000,2000000) audio link=ln_#1
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_#1, it_#2, it_#3, it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig
-- selection: {it_#1} primary it_#1

== freeze at the first frame inserts before the clip
-- command: Freeze frame | FreezeFrame(it_c, 5000000, 2000000, md_still)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_#1 [150,210) md_still src[0,2000000)
  it_c [210,270) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
unchanged: tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1, it_c
-- changed lanes: tr_main
-- selection: {it_#1} primary it_#1

== freeze with a mid-frame time floors it to the frame start
