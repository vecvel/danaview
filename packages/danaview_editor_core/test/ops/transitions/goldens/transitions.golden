== set: fade
-- command: Set transition | SetTransition(tr_main: a|b, TransitionSpec(fade, 30f), clamp: false)
-- before
tr_main video main
  a [0,60) md_video src[10000000,12000000)
  b [60,120) md_video src[10000000,12000000)
  c [120,150) md_video2 src[0,1000000)
  d [200,230) md_image src[0,1000000)
  e [230,260) md_image src[0,1000000)
tr_ov overlay
  o1 [0,20) md_image src[0,666667)
  o2 [20,40) md_image src[0,666667)
tr_lock overlay locked
  l1 [0,20) md_image src[0,666667)
  l2 [20,40) md_image src[0,666667)
tr_txt text
  x [0,30) text "Title"
tr_mus audio role=music
  m1 [0,30) md_music src[0,1000000) audio
  m2 [30,60) md_music src[0,1000000) audio
-- after
tr_main video main
  a [0,60) md_video src[10000000,12000000)
  b [60,120) md_video src[10000000,12000000)
  c [120,150) md_video2 src[0,1000000)
  d [200,230) md_image src[0,1000000)
  e [230,260) md_image src[0,1000000)
  ~ tx_#1 a|b fade 30f
unchanged: tr_ov, tr_lock, tr_txt, tr_mus
-- affected: a, b
-- changed lanes: tr_main

