== paste in the same project into free space
-- command: Paste | PasteItems(1 items, at: 10000000, preferTrack: null, ripple: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  it_#1 [300,360) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
unchanged: tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1
-- changed lanes: tr_main
-- selection: {it_#1} primary it_#1

== paste with ripple on the main lane snaps to a cut and opens space
-- command: Paste | PasteItems(1 items, at: 3333334, preferTrack: null, ripple: true)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_#1 [120,180) md_video2 src[0,2000000)
  it_c [210,270) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
unchanged: tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1, it_c
-- changed lanes: tr_main
-- selection: {it_#1} primary it_#1

== paste without ripple into occupied space goes to a free lane
-- command: Paste | PasteItems(1 items, at: 3333334, preferTrack: null, ripple: false)
-- before: standard()
-- after
tr_#1 video
  it_#1 [100,160) md_video2 src[0,2000000)
unchanged: tr_main, tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1
-- changed lanes: tr_#1
-- created lanes: tr_#1
-- selection: {it_#1} primary it_#1
-- preview creates: video@1

== paste a linked pair keeps them linked under a new link
-- command: Paste | PasteItems(2 items, at: 10000000, preferTrack: null, ripple: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  it_#1 [300,360) md_video src[0,2000000) detached link=ln_#1
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
  it_#2 [300,360) md_video src[0,2000000) audio link=ln_#1
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_#1, it_#2
-- changed lanes: tr_main, tr_orig
-- selection: {it_#1, it_#2} primary it_#1

