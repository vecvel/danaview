== cross-project paste imports, reuses and re-mints media
-- command: Paste | PasteItems(5 items, at: 10000000, preferTrack: null, ripple: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  it_#1 [300,348) md_other src[0,1600000) fade 12f/0f keys{transform.opacity@0f=0.0,7f=1.0} link=ln_#1
  it_#2 [348,372) md_video2 src[0,800000)
  it_#3 [372,396) md_#1 src[5000000,5800000)
  it_#4 [396,420) md_other src[0,800000) rev
  ~ tx_ab it_a|it_b crossDissolve 10f
  ~ tx_#1 it_#1|it_#2 fade 6f
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
  it_#5 [300,348) md_other src[0,1600000) audio link=ln_#1
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- pool added: md_other, md_#1, md_rev
-- affected: it_#1, it_#2, it_#3, it_#4, it_#5
-- changed lanes: tr_main, tr_orig
-- notices: mediaImported x3
-- selection: {it_#1, it_#2, it_#3, it_#4, it_#5} primary it_#1

== cross-project paste from 24 fps re-quantizes onto 30 fps
-- command: Paste | PasteItems(5 items, at: 10000000, preferTrack: null, ripple: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  it_#1 [300,360) md_other src[0,2000000) fade 15f/0f keys{transform.opacity@0f=0.0,9f=1.0} link=ln_#1
  it_#2 [360,390) md_video2 src[0,1000000)
  it_#3 [390,420) md_#1 src[5000000,6000000)
  it_#4 [420,450) md_other src[0,1000000) rev
  ~ tx_ab it_a|it_b crossDissolve 10f
  ~ tx_#1 it_#1|it_#2 fade 8f
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
  it_#5 [300,360) md_other src[0,2000000) audio link=ln_#1
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- pool added: md_other, md_#1, md_rev
-- affected: it_#1, it_#2, it_#3, it_#4, it_#5
-- changed lanes: tr_main, tr_orig
-- notices: mediaImported x3
-- selection: {it_#1, it_#2, it_#3, it_#4, it_#5} primary it_#1

