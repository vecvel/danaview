  it_#1 [0,40) cue "New one"
  it_#2 [50,100) cue "New two"
unchanged: tr_main, tr_m
-- affected: g1, g2, g3, g4, it_#1, it_#2
-- changed lanes: tr_g
-- selection: {} primary -
-- cues
