== add: a new lane on top of the subtitle lanes
-- command: Auto captions | AddGeneratedCaptionTrack(Captions (English), en, 2 cues)
-- before
tr_main video main
  v [0,300) md_video src[0,10000000)
tr_txt text
  x [0,30) text "Title"
tr_s1 subtitle
  c1 [0,30) cue "Hello world"
  c2 [30,60) cue "Second one"
  c3 [90,120) cue "Third"
tr_s2 subtitle
  g1 [0,30) cue "Generated one"
  g2 [45,75) cue "Generated two"
tr_sl subtitle locked
  l1 [0,30) cue "Locked"
-- after
tr_#1 subtitle
  it_#1 [0,30) cue "Hello there"
  it_#2 [30,70) cue "General Kenobi"
unchanged: tr_main, tr_txt, tr_s1, tr_s2, tr_sl
-- affected: it_#1, it_#2
-- changed lanes: tr_#1
-- created lanes: tr_#1
-- selection: {} primary -
-- preview creates: subtitle@5
-- cues
lane tr_s1 "" lang=null burn=true pos=bottom lines=2 size=42.0 prov=null
  [0,30) manual "Hello world"
  [30,60) manual "Second one"
  [90,120) manual "Third"
lane tr_s2 "" lang=en burn=true pos=bottom lines=2 size=42.0 prov=whisper-base-q5_1
  [0,30) generated "Generated one"
  [45,75) generated edited "Generated two"
lane tr_sl "" lang=null burn=true pos=bottom lines=2 size=42.0 prov=null locked
  [0,30) manual "Locked"
lane new3 "Captions (English)" lang=en burn=true pos=bottom lines=2 size=42.0 prov=whisper-base-q5_1
  [0,30) generated "Hello there"
  [30,70) generated "General Kenobi"

