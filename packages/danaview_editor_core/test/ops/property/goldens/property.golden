== set property on a keyed channel writes a key
-- command: Change scale | SetProperty(transform.scale, [it_v], 5.0, at: 333334)
-- before
tr_main video main
  it_v [0,90) md_video src[0,3000000) keys{transform.scale@0f=1.0,30f=2.0,60f=3.0; transform.position.x@0f=0.0,60f=1.0; transform.position.y@0f=0.0,60f=-1.0; audio.volume@0f=1.0,60f=0.5}
  it_s [90,150) md_noaudio src[0,2000000)
tr_ov overlay
  it_p [0,60) md_image src[0,2000000)
tr_ovl overlay locked
  it_l [0,60) md_image src[0,2000000)
tr_txt text
  it_t [0,60) text "Title" keys{transform.scale@0f=1.0,30f=2.0}
  it_t2 [60,120) text "Second"
tr_sub subtitle
  it_c [0,30) cue "Hello"
tr_music audio role=music
  it_a [0,90) md_music src[0,3000000) audio keys{audio.volume@0f=0.2,30f=1.2}
  it_a2 [90,150) md_music src[0,2000000) audio
-- after
