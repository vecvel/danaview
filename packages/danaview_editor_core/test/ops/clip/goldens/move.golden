== move later into free space
-- command: Move clip | MoveItems({it_c}, 1000000, toTrack: null, ripple: false, clamp: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [180,240) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
