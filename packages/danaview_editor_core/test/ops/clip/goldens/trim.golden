-- affected: it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig

== ripple trim shortens a transition to its new limit
-- command: Trim clip | TrimItem(it_a, end, 333334, ripple: true, clamp: false)
-- before
tr_main video main
  it_a [0,60) md_video src[0,2000000)
  it_b [60,120) md_video src[10000000,12000000)
  ~ tx_ab it_a|it_b crossDissolve 50f
-- after
tr_main video main
  it_a [0,10) md_video src[0,333334)
  it_b [10,70) md_video src[10000000,12000000)
  ~ tx_ab it_a|it_b crossDissolve 20f
-- affected: it_a, it_b
-- changed lanes: tr_main
-- notices: transitionsShortened x1

== trim that breaks adjacency drops the transition
