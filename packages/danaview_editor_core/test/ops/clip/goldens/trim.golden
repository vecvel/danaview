== trim a linked clip trims its partner with the same edge
-- command: Trim clip | TrimItem(it_a, end, 1666667, ripple: false, clamp: false)
-- before: standard()
-- after
tr_main video main
  it_a [0,50) md_video src[0,1666667) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
tr_orig audio role=original
  it_a_au [0,50) md_video src[0,1666667) audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_a, it_a_au
-- changed lanes: tr_main, tr_orig
-- notices: transitionsRemoved x1

