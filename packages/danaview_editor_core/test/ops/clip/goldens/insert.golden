== insert ripple at 0 moves the linked partner, not the music
-- command: Add clip | InsertMedia([md_image], at: 0, track: null, mode: auto)
-- before: standard()
-- after
tr_main video main
  it_#1 [0,90) md_image src[0,3000000)
  it_a [90,150) md_video src[0,2000000) detached link=ln_a
  it_b [150,210) md_video src[10000000,12000000)
  it_c [240,300) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_orig audio role=original
  it_a_au [90,150) md_video src[0,2000000) audio link=ln_a
unchanged: tr_ov1, tr_txt, tr_sub, tr_music
-- affected: it_#1, it_a, it_a_au, it_b, it_c
-- changed lanes: tr_main, tr_orig
-- selection: {it_#1} primary it_#1

== insert ripple blocked by a linked partner
-- command: Add clip | InsertMedia([md_image], at: 0, track: null, mode: auto)
-- before
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
tr_ov1 overlay
  it_p1 [30,60) md_image src[0,1000000)
tr_txt text
  it_t1 [0,45) text "Title"
tr_sub subtitle
  it_s1 [0,30) cue "Hello"
tr_orig audio role=original
  it_a_au [0,60) md_video src[0,2000000) audio link=ln_a
  it_x [100,130) md_music src[0,1000000) audio
tr_music audio role=music
  it_m [0,300) md_music src[0,10000000) audio
-- rejected: RippleBlockedByLinkedItem(it_a_au)

== insert two clips back to back (ripple)
-- command: Add clips | InsertMedia([md_image, md_short], at: 7000000, track: null, mode: auto)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_c [150,210) md_video2 src[0,2000000)
  it_#1 [210,300) md_image src[0,3000000)
  it_#2 [300,330) md_short src[0,1000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
unchanged: tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1, it_#2
-- changed lanes: tr_main
-- selection: {it_#1, it_#2} primary it_#1

