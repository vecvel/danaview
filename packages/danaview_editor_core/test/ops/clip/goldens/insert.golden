== insert ripple at a cut (main lane)
-- command: Add clip | InsertMedia([md_video2], at: 4000000, track: null, mode: auto)
-- before: standard()
-- after
tr_main video main
  it_a [0,60) md_video src[0,2000000) detached link=ln_a
  it_b [60,120) md_video src[10000000,12000000)
  it_#1 [120,420) md_video2 src[0,10000000)
  it_c [450,510) md_video2 src[0,2000000)
  ~ tx_ab it_a|it_b crossDissolve 10f
unchanged: tr_ov1, tr_txt, tr_sub, tr_orig, tr_music
-- affected: it_#1, it_c
-- changed lanes: tr_main
-- selection: {it_#1} primary it_#1

