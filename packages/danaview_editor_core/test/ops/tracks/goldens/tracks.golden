== add: video lane goes on top of the video lanes
-- command: Add track | AddTrack(video, "")
-- before
v_main video main
  a [0,60) md_video src[0,2000000) detached link=ln_a
  b [60,120) md_video src[0,2000000)
v2 video
  c [0,60) md_video src[10000000,12000000)
  d [60,120) md_video src[10000000,12000000)
  ~ t_cd c|d crossDissolve 12f
v3 video
ov1 overlay
  o1 [0,30) md_image src[0,1000000)
ov2 overlay locked
  o2 [0,30) md_image src[0,1000000)
t1 text
  x [0,30) text "Title"
s1 subtitle
  q [0,30) cue "Hello"
a_orig audio role=original
  au [0,60) md_video src[0,2000000) audio link=ln_a
a_music audio role=music
  m [0,90) md_music src[0,3000000) audio
a_fx audio role=effects
-- after
tr_#1 video
unchanged: v_main, v2, v3, ov1, ov2, t1, s1, a_orig, a_music, a_fx
-- affected: 
-- changed lanes: tr_#1
-- created lanes: tr_#1
-- selection: {} primary -
-- preview creates: video@3
-- details
lane v_main video [main] items=2
lane v2 video items=2
lane v3 video items=0
lane new3 video items=0
lane ov1 overlay items=1
lane ov2 overlay [locked] items=1
lane t1 text items=1
lane s1 subtitle items=1
lane a_orig audio role=original items=1
lane a_music audio "Score" role=music items=1
lane a_fx audio role=effects items=0
marker mk1 @30f "Intro" color=2 note="Start here"
marker mk2 @90f "" color=0
marker mk3 @150f "Outro" color=5
settings canvas=CanvasSpec(16:9, 1920x1080) rate=30 fps background=solid ff000000

