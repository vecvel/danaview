<?xml version="1.0" encoding="utf-8"?>
<!-- OWNER: ENG-08 (then ENG-06 [INTEGRATION], frozen; D-42)
     Plugin manifest of the editor engine (ARCH §20.4). Merged into the host app's manifest.
     - RECORD_AUDIO: voice recording (AND-13), requested in context.
     - POST_NOTIFICATIONS: export progress notification (AND-12), requested in context (API 33+).
     - FOREGROUND_SERVICE + the API 34 type permissions: ExportService runs as dataSync on API 29-34
       and mediaProcessing on API 35+ (ARCH §14.3). FOREGROUND_SERVICE itself is required for any
       startForeground call since API 28.
     - WRITE_EXTERNAL_STORAGE only up to API 28; the editor gate is API 29+ (MediaStore pending
       inserts need no permission there), so it only keeps the player's floor consistent.
       READ_EXTERNAL_STORAGE is deliberately not declared: the Danaview app declares it (maxSdk 32), and
       a second declaration with another maxSdkVersion is a merge error. A host without its own
       READ_EXTERNAL_STORAGE gets the merger's implied (unbounded, never requested) one.
     - No READ_MEDIA_IMAGES/VIDEO: media is added through pickers only (ARCH §20.1 rule 5).
     - FileProvider subclass (glue/EditorFileProvider.kt) so the merge never clashes with another
       library's androidx.core.content.FileProvider entry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <application>
        <!-- Export foreground service (AND-12). -->
        <service
            android:name="com.vecvel.danaview.editor.engine.export.ExportService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <!-- Share / SAF handoff of engine outputs (AND-12 FileHandoff). -->
        <provider
            android:name="com.vecvel.danaview.editor.engine.glue.EditorFileProvider"
            android:authorities="${applicationId}.danaview.editor.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/danaview_editor_file_paths" />
        </provider>

        <!-- Photo Picker backport: asks Google Play services to install the picker module on
             devices without the platform Photo Picker (AND-14). -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data
                android:name="photopicker_activity:0:required"
                android:value="" />
        </service>
    </application>
</manifest>
