<?xml version="1.0" encoding="UTF-8"?>
<!-- OWNER: HOM-02 (FIX-S2R-1). Privacy manifest of the danaview_library_native pod: no tracking, no
     collected data; required-reason API: file timestamps (C617.1) - content modification dates and
     file attributes of files inside the app container and of files the user picked or shares out
     (pickers, save out / share / open in, photo library copies). Nothing leaves the device. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
