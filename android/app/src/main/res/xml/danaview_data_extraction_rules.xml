<?xml version="1.0" encoding="utf-8"?>
<!--
  OWNER: CORE-28 (ARCH §8.1, D-20, D-43 f).
  Auto Backup and device transfer rules for Android 12 (API 31) and later.

  The whole video editor tree (files/danaview/editor: projects, voice recordings, managed copies,
  derived renditions) and the speech tree (files/danaview/speech: models, transcripts, jobs) are
  excluded. Android backup rules take no wildcards, so per-project recordings cannot be excluded
  selectively, and going over the 25 MB Auto Backup quota would fail the WHOLE app backup
  (player library and profile included). Persisted URI grants and managed copies do not survive a
  restore anyway. Everything else (the player's data) stays included. Verified with the bmgr
  procedure in packages/danaview_editor_core/test/store/gc/README.md (V-A7, QA-10).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="danaview/editor" />
        <exclude domain="file" path="danaview/speech" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="danaview/editor" />
        <exclude domain="file" path="danaview/speech" />
    </device-transfer>
</data-extraction-rules>
