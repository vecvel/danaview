<?xml version="1.0" encoding="utf-8"?>
<!--
  OWNER: CORE-28 (ARCH §8.1, D-20, D-43 f).
  Auto Backup rules for Android 11 (API 30) and earlier (android:fullBackupContent).
  Same policy as danaview_data_extraction_rules.xml: the editor and speech trees under files/ are
  excluded; the player's data stays included.
-->
<full-backup-content>
    <exclude domain="file" path="danaview/editor" />
    <exclude domain="file" path="danaview/speech" />
    <!-- EXTENDED: D-3, Windows lane (ARCH V2-115, owner 2026-10-22). Auto Backup on API <= 30 can't
         tell cloud backup from device transfer, so the Danaview library (files/library: library.db,
         files/, imports/) is left out entirely here. -->
    <exclude domain="file" path="library" />
    <!-- EXTENDED: S4-W (HOM-30 / HOM-30A contract, privacy text). Saved signatures of the PDF sign
         tool (files/signatures) stay on this device only: never in a backup. -->
    <exclude domain="file" path="signatures" />
</full-backup-content>
