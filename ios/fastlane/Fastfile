# iOS release lanes. Run from the ios/ folder:  fastlane ios <lane>
# Credentials are read from ios/fastlane/.env (git-ignored); see .env.example.

default_platform(:ios)

ROOT = File.expand_path("../..", __dir__)
IPA_DIR = File.join(ROOT, "build/ios/ipa")

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
  end

  # Lanes that upload screenshots run with overwrite_screenshots: true, which deletes every
  # screenshot in App Store Connect before uploading the local ones. With an empty folder that
  # would leave the listing without screenshots, so refuse to run until they are regenerated.
  def require_screenshots!(relative_dir)
    dir = File.join(ROOT, "ios", relative_dir)
    shots = Dir.glob(File.join(dir, "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD)
    return unless shots.empty?

    UI.user_error!("No screenshots in ios/#{relative_dir}: this lane uploads with overwrite_screenshots " \
                   "and would delete the store screenshots. Regenerate them first (see ios/#{relative_dir}/README.md).")
  end

  def next_build_number
    latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
  rescue StandardError => e
    UI.important("Could not query latest TestFlight build number: #{e.message}. Using 1.")
    1
  end

  def flutter_ipa(build_number)
    Dir.chdir(ROOT) do
      sh("flutter", "build", "ipa", "--release",
         "--export-options-plist=ios/ExportOptions.plist",
         "--build-number=#{build_number}")
    end
    Dir[File.join(IPA_DIR, "*.ipa")].max_by { |f| File.mtime(f) } || File.join(IPA_DIR, "danaview.ipa")
  end

  desc "Build a signed App Store IPA locally (build number from BUILD_NUMBER or 1)"
  lane :build do
    flutter_ipa(ENV["BUILD_NUMBER"] || 1)
  end

  desc "Sync metadata, screenshots, and age rating to App Store Connect without binary"
  lane :metadata do
    require_screenshots!("fastlane/screenshots")
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload screenshots only to App Store Connect"
  lane :screenshots do
    require_screenshots!("fastlane/screenshots")
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload Mac screenshots to App Store Connect"
  lane :mac_screenshots do
    require_screenshots!("fastlane/screenshots_mac")
    upload_to_app_store(
      api_key: api_key,
      platform: "osx",
      app_version: "1.0",
      screenshots_path: "fastlane/screenshots_mac",
      skip_binary_upload: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload Mac metadata to App Store Connect"
  lane :mac_metadata do
    upload_to_app_store(
      api_key: api_key,
      platform: "osx",
      app_version: "1.0",
      metadata_path: "fastlane/metadata_mac",
      skip_binary_upload: true,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Verify Mac metadata in App Store Connect"
  lane :verify_mac_metadata do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
    app = Spaceship::ConnectAPI::App.find("com.vecvel.danaview")
    mac_version = app.get_app_store_versions(filter: { platform: "MAC_OS" }).first
    loc = mac_version.get_app_store_version_localizations.first
    UI.header("App Store Connect macOS Metadata")
    UI.message("Version: #{mac_version.version_string} (#{mac_version.app_store_state})")
    UI.message("Locale: #{loc.locale}")
    UI.message("Description length: #{loc.description&.length || 0} chars")
    UI.message("Description preview: #{loc.description&.slice(0, 120)}...")
    UI.message("Keywords: #{loc.keywords}")
    UI.message("Support URL: #{loc.support_url}")
    UI.message("Marketing URL: #{loc.marketing_url}")
    UI.message("Promotional Text: #{loc.promotional_text}")
    builds = app.get_builds(filter: { "preReleaseVersion.platform" => "MAC_OS" })
    UI.message("macOS Builds: #{builds.map { |b| "build #{b.version} (#{b.processing_state})" }.join(', ')}")
    current_build = mac_version.build
    UI.message("Currently selected build: #{current_build&.version || 'None'}")
    valid_builds = builds.select { |b| b.processing_state == "VALID" }.sort_by { |b| b.version.to_i }
    latest_valid = valid_builds.last
    if latest_valid && (current_build.nil? || current_build.version != latest_valid.version)
      UI.message("Attaching build #{latest_valid.version} to macOS version #{mac_version.version_string}...")
      mac_version.select_build(build_id: latest_valid.id)
      UI.success("Successfully attached build #{latest_valid.version}!")
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ipa = flutter_ipa(next_build_number)
    upload_to_testflight(api_key: api_key, ipa: ipa, skip_waiting_for_build_processing: true)
  end

  desc "Build signed IPA and upload binary to App Store Connect"
  lane :release do
    build_num = ENV["BUILD_NUMBER"] || 1
    ipa = flutter_ipa(build_num)
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  def macos_pkg(build_number)
    if ENV["PKG"] && File.exist?(ENV["PKG"])
      UI.message("Using pre-built PKG: #{ENV['PKG']}")
      return ENV["PKG"]
    end

    Dir.chdir(ROOT) do
      UI.message("1/3 Building macOS release with Flutter...")
      sh("flutter", "build", "macos", "--release", "--build-number=#{build_number}")

      UI.message("2/3 Archiving macOS Runner with Xcode...")
      sh(
        "xcodebuild",
        "-workspace", "macos/Runner.xcworkspace",
        "-scheme", "Runner",
        "-configuration", "Release",
        "archive",
        "-archivePath", "build/macos/Runner.xcarchive",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
      )

      UI.message("3/3 Exporting signed PKG with Xcode...")
      sh(
        "xcodebuild",
        "-exportArchive",
        "-archivePath", "build/macos/Runner.xcarchive",
        "-exportOptionsPlist", "macos/ExportOptions.plist",
        "-exportPath", "build/macos/export",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
      )
    end
    File.join(ROOT, "build/macos/export/danaview.pkg")
  end

  desc "Build signed PKG and upload binary to App Store Connect for macOS"
  lane :mac_release do |options|
    build_num = (options && (options[:build_number] || options[:BUILD_NUMBER])) || ENV["BUILD_NUMBER"] || 2
    pkg = macos_pkg(build_num)
    upload_to_app_store(
      api_key: api_key,
      platform: "osx",
      app_version: "1.0",
      metadata_path: "fastlane/metadata_mac",
      pkg: pkg,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end
end

