<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OWNER: INT-03

  Background GPU for continued-processing exports on iPad, iOS 26+ (ARCH §14.2, §20.4; D-22).
  The Runner target signs with this file only when the build setting DANAVIEW_BG_GPU_ENTITLEMENT
  is YES (project.pbxproj resolves CODE_SIGN_ENTITLEMENTS from it). It stays NO until Apple grants
  the entitlement to com.vecvel.danaview; with NO the app is signed without entitlements and every
  device exports with the `paused` background kind.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
