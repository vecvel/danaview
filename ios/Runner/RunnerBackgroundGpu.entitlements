<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OWNER: INT-104 (split out of INT-03's Runner.entitlements)

  Runner.entitlements plus background GPU for continued-processing exports on iPad, iOS 26+
  (v1.1 ARCH §14.2, §20.4; D-22). The Runner target signs with this file only when the build
  setting DANAVIEW_BG_GPU_ENTITLEMENT is YES. It stays NO until Apple grants the entitlement to
  com.vecvel.danaview; with NO the app signs with Runner.entitlements (App Group only) and every
  device exports with the `paused` background kind. Keep the App Group identical to Runner.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vecvel.danaview</string>
	</array>
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
